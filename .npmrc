; The devDependencies pin @deepseek-ai packages to the versions shipped by
; the dsh host (types-only devDeps). Their cross-package peer ranges cannot
; be satisfied from the public registry alone, so keep npm v6 peer semantics
; and let pnpm skip auto-installing peers (same as dsh-vault / dsh-model-sync).
legacy-peer-deps=true
auto-install-peers=false
